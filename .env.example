# Apex environment configuration
# Copy to .env and fill in real values — never commit .env itself.
#
# Security: .env is git-ignored (see .gitignore). This file is safe to commit.
# The LLM key is never sent to Apex servers; it stays in your local process.

# LLM API key (used when provider.api_key_env = "APEX_KEY" in apex.json)
APEX_KEY=sk-or-placeholder

# Optional: override the provider configured in apex.json
# APEX_PROVIDER=anthropic
# APEX_MODEL=claude-3-5-sonnet-20241022

# Optional: UI settings override
# APEX_UI_LANGUAGE=en
# APEX_UI_THEME=dark
